# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Every variable is optional — VIZE works fully without them.

# AI writing assist (Polish, Shorten, Auto-highlight, Title ideas, Post caption).
# Get a key at https://console.anthropic.com — usage is billed to your Anthropic account.
ANTHROPIC_API_KEY=

# Short share links (/s/a8Kd2xQ) + shared rate limiting.
# Easiest: Vercel → Storage → Upstash for Redis (free) — it sets these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
